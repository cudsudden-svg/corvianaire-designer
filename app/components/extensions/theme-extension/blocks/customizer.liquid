{% comment %}
  Corvianaire Studio — Product Customizer app block.

  Merchants add this block to their product page template via the theme
  editor. It renders a mount point + passes the product handle down via a
  data attribute. The bundle below (built from apps/storefront-widget, see
  its vite.config.ts) reads that attribute, calls our app proxy
  (/apps/studio/products/:handle) to fetch live product data, and mounts
  the real Fabric.js canvas editor into this div.

  Nothing about the product is hardcoded or baked in here — nothing but
  the handle Shopify already knows, at render time, for whatever product
  page this block happens to be placed on.

  customizer.js/customizer.css are BUILD OUTPUT, not source — they're
  generated by `npm run build` in apps/storefront-widget, which writes
  directly into this extension's assets/ folder. Don't hand-edit them.
{% endcomment %}

<div
  id="corvianaire-studio-root"
  data-product-handle="{{ product.handle }}"
  data-shop-domain="{{ shop.permanent_domain }}"
  data-customer-id="{{ customer.id }}"
>
  <div class="corvianaire-studio-loading">Loading product customizer…</div>
</div>

<link rel="stylesheet" href="{{ 'customizer.css' | asset_url }}">
<script type="module" src="{{ 'customizer.js' | asset_url }}"></script>

{% schema %}
{
  "name": "Product Customizer",
  "target": "section",
  "settings": []
}
{% endschema %}

{
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "vite.config.ts",
    ".react-router/types/**/*"
  ],
  "compilerOptions": {
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",

    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,

    "baseUrl": ".",

    "paths": {
      "~/*": ["./app/*"]
    },

    "ignoreDeprecations": "6.0",

    "types": [
      "@react-router/node",
      "vite/client",
      "@shopify/polaris-types"
    ],

    "rootDirs": [
      ".",
      "./.react-router/types"
    ]
  }
}
